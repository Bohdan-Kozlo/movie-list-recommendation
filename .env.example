# Application
APP_ENV=development
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
WEB_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=movie_recommendation
POSTGRES_USER=movie_app
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=postgresql://movie_app:change-me-for-local-development@localhost:5432/movie_recommendation

# TMDB catalogue synchronization (v3 API key; never commit a real key)
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3

# Ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# MLflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://localhost:5000

# Qdrant Cloud (external; never commit a real key)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=movie-list-recommendation
